# Copy to .env and fill in. .env is git-ignored; never commit a real key.
#
# Most of this repo needs nothing here. The container, the k8s manifests, the
# dashboards, the load generator and the cost model all run against a local
# server with no credentials at all.

# ---------------------------------------------------------------- serving --
# Where the vLLM server is. The load generator, the quality gate and Project
# 01's harness all read this same variable, because all three speak the same
# OpenAI-compatible wire format.
SERVE_BASE_URL=http://localhost:8000

# The model id the server reports at /v1/models. Must match what vLLM was
# started with, or requests 404 with a confusing message.
SERVE_MODEL=

# ------------------------------------------------------------ eval gate ---
# Project 01 reads this to point its `open-weight-local` row at our server.
# Same value as SERVE_BASE_URL -- kept separate because the harness owns the
# name and we do not get to rename another project's interface.
NIM_BASE_URL=http://localhost:8000
NIM_MODEL=

# --------------------------------------------------------- API baseline ---
# Only needed to re-measure the API side of the crossover chart. The committed
# comparison uses prices from Project 01's registry, which carries the date
# they were read; this key is for re-running the quality half of the match.
ANTHROPIC_API_KEY=
