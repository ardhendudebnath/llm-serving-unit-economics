{
  "uid": "llm-serving-unit-economics",
  "title": "LLM serving: latency, utilisation and cost",
  "description": "One served open-weight model. The cost row is the point: a per-request cost figure means nothing without the GPU utilisation sitting next to it.",
  "tags": ["vllm", "llm", "cost", "gpu"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "slo",
        "label": "p95 SLO (seconds)",
        "type": "constant",
        "query": "5",
        "current": { "text": "5", "value": "5" },
        "hide": 0,
        "description": "Must match the SLO the cost curves were computed against. Changing it here does not change the published crossover."
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "RED — rate, errors, duration",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 1,
      "title": "Request rate",
      "description": "Successful requests per second. The denominator of every cost-per-request figure on this dashboard.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(vllm:request_success_total[5m]))",
          "legendFormat": "served"
        },
        {
          "refId": "B",
          "expr": "sum(rate(vllm:request_failure_total[5m]))",
          "legendFormat": "failed"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Error rate",
      "description": "Threshold is 1% — the same ceiling bench.metrics.find_knee uses to disqualify a load point. A server meeting its latency target by shedding requests has not met it.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "fillOpacity": 10, "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(vllm:request_failure_total[5m])) / clamp_min(sum(rate(vllm:request_success_total[5m])) + sum(rate(vllm:request_failure_total[5m])), 1)",
          "legendFormat": "error rate"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "End-to-end latency percentiles",
      "description": "p50, p95, p99 — never a mean. An average latency figure hides exactly the tail that decides whether the deployment meets its SLO.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": { "fillOpacity": 0, "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },

    {
      "type": "row",
      "id": 101,
      "title": "Cost — and whether it is honest",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Cost per 1000 requests",
      "description": "Live, from the current request rate. Diverges sharply from the published figure whenever utilisation is low — which is exactly why it sits beside the utilisation gauge.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 4 },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "refId": "A", "expr": "serving:cost_per_1000_requests_usd", "legendFormat": "per 1k" }
      ]
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Running cost per hour",
      "description": "Flat regardless of load. A GPU bills the same idle as saturated, and that flatness is the entire economic story behind the crossover chart.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 3 },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "refId": "A", "expr": "serving:cost_per_hour_usd", "legendFormat": "per hour" }
      ]
    },
    {
      "type": "gauge",
      "id": 6,
      "title": "GPU utilisation",
      "description": "The number that reveals whether the cost figure is honest. Below 20% the per-request cost is dominated by idle time and the API almost certainly wins — that threshold is the GpuUnderutilisedCostWaste alert.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 20 },
              { "color": "green", "value": 60 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "avg(DCGM_FI_DEV_GPU_UTIL)", "legendFormat": "GPU" }
      ]
    },
    {
      "type": "gauge",
      "id": 7,
      "title": "VRAM used",
      "description": "At long context the KV cache, not the weights, is what runs a card out of memory.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 85 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * avg(DCGM_FI_DEV_FB_USED) / clamp_min(avg(DCGM_FI_DEV_FB_USED) + avg(DCGM_FI_DEV_FB_FREE), 1)",
          "legendFormat": "VRAM"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Cost per 1000 requests over time",
      "description": "Rises whenever traffic falls, because the GPU cost does not. This is the sawtooth the crossover chart flattens into a step function.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "custom": { "fillOpacity": 10, "drawStyle": "line" }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "serving:cost_per_1000_requests_usd", "legendFormat": "$/1k requests" }
      ]
    },

    {
      "type": "row",
      "id": 102,
      "title": "Serving internals — batching and the KV cache",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Queue depth and batch size",
      "description": "num_requests_waiting is what the HPA scales on, because it rises before latency does — queueing is the mechanism by which p95 degrades. num_requests_running is the live continuous batch.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(vllm:num_requests_waiting)", "legendFormat": "queued" },
        { "refId": "B", "expr": "sum(vllm:num_requests_running)", "legendFormat": "in batch" }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "KV cache usage",
      "description": "Past ~95% vLLM starts preempting sequences, which shows up as a latency tail long before it shows up as an error.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "fillOpacity": 10, "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "avg(vllm:gpu_cache_usage_perc)", "legendFormat": "KV cache" }
      ]
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Tokens per second",
      "description": "Prefill and decode throughput separately. long_in is prefill-bound, long_out decode-bound — the two profiles move these lines in opposite directions.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(vllm:prompt_tokens_total[5m]))", "legendFormat": "prompt (in)" },
        { "refId": "B", "expr": "sum(rate(vllm:generation_tokens_total[5m]))", "legendFormat": "generated (out)" }
      ]
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Time to first token",
      "description": "What a user perceives as responsiveness. Moves quite differently from total latency once continuous batching engages.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "fillOpacity": 0 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },

    {
      "type": "row",
      "id": 103,
      "title": "Input distribution — drift detection",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Prompt length distribution",
      "description": "Prompt length is the input statistic that costs money here: prefill grows with it and KV cache footprint grows with it, so traffic getting longer degrades latency and capacity together — with no code change and no error. The dashed line is the same hour last week, which is what the drift alert compares against.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 41 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "fillOpacity": 0 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p50 (7d ago)" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:request_prompt_tokens_bucket[1h])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:request_prompt_tokens_bucket[1h])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:request_prompt_tokens_bucket[1h] offset 7d)))",
          "legendFormat": "p50 (7d ago)"
        }
      ]
    }
  ]
}
